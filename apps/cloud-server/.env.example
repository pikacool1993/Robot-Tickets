MYSQL_ROOT_PASSWORD=change-root-password
MYSQL_DATABASE=robot
MYSQL_APP_USER=robot_app
MYSQL_APP_PASSWORD=change-app-password
MYSQL_PORT=3306

ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=change-admin-password

# The client-v1 value is a Base64-encoded 32-byte AES key used by agent APIs.
# Generate transport and credential keys: go run ./cmd/generate-keys
TRANSPORT_KEYS_JSON={"client-v1":"replace-with-base64-key"}
AGENT_TRANSPORT_KEY_ID=client-v1
AGENT_CREDENTIAL_ENCRYPTION_KEY=replace-with-base64-key
AGENT_CREDENTIAL_KEY_VERSION=v1

SERVER_PORT=8080

# Optional .cfg export: set ALL five values to enable; leave all empty to disable.
# Run `go run ./cmd/config-keys` for independent keys and the client verification public key.
# Use a server URL reachable from customer PCs, without an API path.
CLIENT_CONFIG_SERVER_URL=
CLIENT_CONFIG_ENCRYPTION_KEY_ID=
CLIENT_CONFIG_ENCRYPTION_KEY=
CLIENT_CONFIG_SIGNING_KEY_ID=
CLIENT_CONFIG_SIGNING_SEED=
